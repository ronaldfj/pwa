rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /logs/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
